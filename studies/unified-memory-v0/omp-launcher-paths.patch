+def run_incorrect_artifact_control(candidate: Path, run_dir: Path) -> dict[str, Any]:
+    """Run the held oracle against one corrupted copy of this exact native artifact."""
+    with tempfile.TemporaryDirectory(prefix="incorrect-artifact-", dir=run_dir.parent) as temporary:
+        negative_root = Path(temporary) / "candidate"
+        subprocess.run(["git", "clone", "--quiet", "--shared", "--no-checkout", str(candidate), str(negative_root)], check=True)
+        git(negative_root, "checkout", "--quiet", "--detach", Z0INT_REF)
+        artifact = candidate / OUTPUT_REL
+        tree = ast.parse(artifact.read_text(encoding="utf-8"))
+        changed = 0
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Call) and dotted_name(node.func) == "json.dumps" and node.args:
+                node.args[0] = ast.Dict(keys=[None, ast.Constant("source_version")], values=[node.args[0], ast.Constant("deliberately-incorrect-fixed-identity")])
+                changed += 1
+        require(changed == 1, "negative control requires one evidence serializer")
+        ast.fix_missing_locations(tree)
+        target = negative_root / OUTPUT_REL
+        target.parent.mkdir(exist_ok=True)
+        target.write_text(ast.unparse(tree) + "\n", encoding="utf-8")
+        control_dir = run_dir.parent / (run_dir.name + "-incorrect-control")
+        control_dir.mkdir(mode=0o700)
+        write_private(control_dir / "incorrect_probe_exact_path.py", target.read_bytes())
+        env, _ = python_env(negative_root)
+        env["Z0_QUALIFICATION_CANDIDATE"] = str(negative_root)
+        argv = [str(PYTHON), "-m", "pytest", "-q", "-p", "no:cacheprovider", str(D2_ORACLE)]
+        proc = subprocess.run(argv, cwd=negative_root, env=env, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=180, check=False)
+        write_private(control_dir / "test-output.txt", proc.stdout.encode())
+        proof = {"control_artifact_path": str(control_dir / "incorrect_probe_exact_path.py"), "output_path": str(control_dir / "test-output.txt"), "positive_artifact_sha256": digest_file(artifact), "incorrect_artifact_sha256": digest_file(target), "oracle_sha256": D2_ORACLE_SHA, "argv": argv, "actual_exit_code": proc.returncode, "output_sha256": digest_bytes(proc.stdout.encode()), "failed_for_incorrect_identity": "deliberately-incorrect-fixed-identity" in proc.stdout, "agent_execution": False}
+        require(proc.returncode != 0 and proof["failed_for_incorrect_identity"], "incorrect artifact did not fail the pinned behavioral oracle")
+        return proof
