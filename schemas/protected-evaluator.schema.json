{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kvnloo/z0evals/schemas/protected-evaluator.schema.json",
  "title": "z0eval protected evaluator",
  "type": "object",
  "required": ["schema", "id", "version", "label_generator", "verifier", "cohorts", "scoring"],
  "properties": {
    "schema": {"const": "z0eval.protected.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "minLength": 1},
    "label_generator": {
      "type": "object",
      "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "verifier": {
      "type": "object",
      "required": ["id", "independent_of"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "independent_of": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "cohorts": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "required": ["role", "optimizer_queryable", "training_allowed", "truth_ref"],
        "properties": {
          "role": {"enum": ["development", "confirm", "ood", "future"]},
          "optimizer_queryable": {"type": "boolean"},
          "training_allowed": {"type": "boolean"},
          "truth_ref": {"type": "string", "pattern": "^env://[A-Z_][A-Z0-9_]*(/.*)?$"}
        },
        "additionalProperties": false
      }
    },
    "scoring": {
      "type": "object",
      "required": ["metric", "pass_threshold", "max_queries"],
      "properties": {
        "metric": {"const": "exact_match"},
        "pass_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "max_queries": {"type": "integer", "minimum": 1, "maximum": 1000}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
