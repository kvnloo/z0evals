{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kvnloo/z0evals/schemas/study-manifest.schema.json",
  "title": "z0eval study manifest",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "created",
    "sources",
    "questions",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "z0eval.study.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "frozen",
        "published",
        "superseded"
      ]
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "hardware": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "repo",
          "commit"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "branch": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "dataset",
              "receipt",
              "result",
              "figure",
              "analysis",
              "fixture",
              "log",
              "other"
            ]
          },
          "sha256": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "supersession": {
      "description": "How this study's INTERPRETATION was superseded without altering its measurement. A study may say 'measurement unchanged / interpretation superseded' and stay immutable: the artifact hashes below are the guarantee, and validate.py still checks them. Never rewrite a frozen result to change what it is taken to mean -- record the change here.",
      "type": "object",
      "required": [
        "superseded_by",
        "measurement_unchanged",
        "interpretation_changed",
        "what_changed",
        "recorded"
      ],
      "properties": {
        "superseded_by": {
          "type": "string",
          "minLength": 1,
          "description": "id of the study that replaces this interpretation"
        },
        "measurement_unchanged": {
          "type": "boolean",
          "description": "true when every artifact hash still verifies. Enforced: a true value requires at least one hashed artifact, and those hashes must still match, which is what makes the claim checkable rather than asserted."
        },
        "interpretation_changed": {
          "type": "boolean",
          "description": "true when what the measurement is taken to mean has changed"
        },
        "what_changed": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "recorded": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "evidence": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
