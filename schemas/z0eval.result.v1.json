{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kvnloo/z0evals/schemas/z0eval.result.v1.json",
  "title": "Frozen study result, not production routing authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite_id", "suite_revision", "system_revision", "baseline_revision", "verdict", "gates", "evidence", "limitations", "family", "job", "arm", "metric", "evidence_class", "scope_note", "ts", "findings"],
  "properties": {
    "schema": {"const": "z0eval.result.v1"},
    "suite_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "suite_revision": {"$ref": "#/$defs/revision"},
    "system_revision": {"$ref": "#/$defs/revision"},
    "baseline_revision": {"$ref": "#/$defs/revision"},
    "verdict": {"enum": ["KEEP", "DISCARD", "PARTIAL"]},
    "gates": {
      "type": "object",
      "required": ["contract", "authority", "quality_noninferiority", "latency_tail"],
      "properties": {
        "contract": {"$ref": "#/$defs/gate"},
        "authority": {"$ref": "#/$defs/gate"},
        "quality_noninferiority": {"$ref": "#/$defs/gate"},
        "latency_tail": {"$ref": "#/$defs/gate"}
      },
      "additionalProperties": {"$ref": "#/$defs/gate"}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenomics_artifacts", "source_artifacts", "result_hashes"],
      "properties": {
        "tokenomics_artifacts": {"$ref": "#/$defs/refs"},
        "source_artifacts": {"$ref": "#/$defs/refs"},
        "result_hashes": {"$ref": "#/$defs/refs"}
      },
      "anyOf": [
        {"properties": {"tokenomics_artifacts": {"minItems": 1}}},
        {"properties": {"source_artifacts": {"minItems": 1}}},
        {"properties": {"result_hashes": {"minItems": 1}}}
      ]
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "family": {"$ref": "#/$defs/text"},
    "job": {"$ref": "#/$defs/text"},
    "arm": {"$ref": "#/$defs/arm"},
    "metric": {"$ref": "#/$defs/metric"},
    "evidence_class": {"$ref": "#/$defs/evidence_class"},
    "scope_note": {"$ref": "#/$defs/text"},
    "ts": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "baseline": {"$ref": "#/$defs/baseline"},
    "synthetic": {"type": "boolean", "description": "Synthetic evidence is a test artifact, not a real experiment promotion."},
    "findings": {
      "description": "The emitter derives this one-item consumer view from the top-level fields. It must not disagree with them.",
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gate": {"enum": ["pass", "fail", "not_run"]},
    "evidence_class": {"enum": ["measured", "replayed_L1", "replayed_L2", "canary", "published", "inference"]},
    "refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "arm": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "model", "quant", "engine", "backend", "device"],
      "properties": {
        "kind": {"enum": ["rules", "knn", "slm", "llm", "engine"]},
        "model": {"$ref": "#/$defs/text"},
        "quant": {"$ref": "#/$defs/text"},
        "engine": {"$ref": "#/$defs/text"},
        "backend": {"$ref": "#/$defs/text"},
        "device": {"$ref": "#/$defs/text"}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value", "n", "ci_low", "ci_high", "ci_method", "higher_is_better"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "value": {"type": "number"},
        "n": {"type": "integer", "minimum": 1},
        "ci_low": {"type": "number"},
        "ci_high": {"type": "number"},
        "ci_method": {"type": "string", "minLength": 1, "not": {"enum": ["none", "unknown", "not_run"]}},
        "higher_is_better": {"type": "boolean"},
        "live_shadow": {"type": "boolean"},
        "divergence": {"type": "number", "minimum": 0},
        "aa_noise_floor": {"type": "number", "minimum": 0},
        "outcome_ledger_verified": {"type": "boolean"}
      }
    },
    "baseline": {
      "type": "object", "additionalProperties": false, "required": ["arm", "value"],
      "properties": {"arm": {"$ref": "#/$defs/text"}, "value": {"type": "number"}}
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "arm", "metric", "evidence_class", "scope_note", "ts"],
      "properties": {
        "subject": {
          "type": "object", "additionalProperties": false, "required": ["family", "job"],
          "properties": {"family": {"$ref": "#/$defs/text"}, "job": {"$ref": "#/$defs/text"}}
        },
        "arm": {"$ref": "#/$defs/arm"},
        "metric": {"$ref": "#/$defs/metric"},
        "evidence_class": {"$ref": "#/$defs/evidence_class"},
        "synthetic": {"type": "boolean"},
        "scope_note": {"$ref": "#/$defs/text"},
        "ts": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "baseline": {"$ref": "#/$defs/baseline"}
      }
    }
  }
}
