+summary['round_1_corrections']['xhigh_generalization']['replacement'] = 'Round-1 xhigh whole-arm ratios are historical scope; low effort costs 4.9 times less per line in the sweep at the same 38/40 Sonnet-reader score. Long replay cost also depends on compactor price and read weight.'
+
+# Each of the 37 reviewer items has a separate disposition, preserving review order.
+entries = []
