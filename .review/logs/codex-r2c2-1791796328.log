        self.repo = repo or T / "scratch" / "e5-A-repo"
        self.out = out or RES / tag
        if not self.repo.exists() or not any(self.repo.iterdir()):
            mkrepo.build(self.repo)
        if not (self.root / "config.json").exists():
            Chat.init(self.root, name="Unii")                       # the gist's limits
            (self.root / "instructions.md").write_text(INSTR.format(repo=self.repo))
        self.chat = Chat(self.root, write=True)
        assert self.chat.gist_limits()
        work = self.root.with_name(self.root.name + ".work")
        meta = {"limits": [self.chat.view.high, self.chat.view.low, self.chat.cview.high, self.chat.cview.low],
                "gist_limits": True}
        common = dict(calls=self.out / "calls.jsonl", ledger=LEDGER, experiment=self.exp, placement="user-blocks",
                      system_mode="replace", meta=meta, timeout=1500.0)
        self.turn_backend = BudgetCLI(work, effort=None, **common)
        self.comp_backend = BudgetCLI(work, effort=effort, **common)
        self.turn_backend.cwd = self.comp_backend.cwd = self.repo   # the shell tool runs in the repository
        self.tools = tools_config(self.root)
        self.tools.update(builtin=TOOLS, env=ENV)
        self.tools["allowed"] = self.tools["allowed"] + rules(self.repo)
        ctools = tools_config(self.root, callable_=False)
        ctools.update(builtin=TOOLS, env=ENV)                       # the turns' tool block, never callable
        self.bg = None
        if compact:
