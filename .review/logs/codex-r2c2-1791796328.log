+e5['compaction_unit_price_sensitivity'] = {
+    'n_turns_per_arm': 112, 'n_compaction_sends': 2383, 'runs_per_arm': 1,
+    'W': 2, 'read_weight': .1, 'compaction_own_Haiku_units': round(comp_units, 1),
