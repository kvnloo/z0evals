def units(usage: dict) -> float:
    cc = usage.get("cache_creation") or {}
    w1h, w5m = cc.get("ephemeral_1h_input_tokens") or 0, cc.get("ephemeral_5m_input_tokens") or 0
    rest = (usage.get("cache_creation_input_tokens") or 0) - w1h - w5m
    return ((usage.get("input_tokens") or 0) + 2 * (w1h + max(rest, 0)) + 1.25 * w5m
            + 0.1 * (usage.get("cache_read_input_tokens") or 0) + 5 * (usage.get("output_tokens") or 0))


def frac(a: int, n: int) -> str:
    return f"{a}/{n} ({100 * a / n:.0f}%)" if n else "0/0"


def med(xs):
    xs = list(xs)
    return round(st.median(xs), 2) if xs else None


def mean(xs):
    xs = list(xs)
    return round(st.mean(xs), 2) if xs else None


def analyze(arm: str, msgs, items, orders, corrections, limit: int | None = None) -> dict:
    """limit: only the nodes (and their sends) that lie inside messages 0..limit-1."""
    fam = "sonnet" if "sonnet" in arm else "haiku"
    rows = load_jsonl(E4 / arm / "calls.jsonl")
    prev = {}
    for r in sorted(rows, key=lambda r: r["ts"]):
        r["_key"], r["_text"] = key_of(r.get("label", "")), reply_text(r)
        # the CLI's total_cost_usd is cumulative over one process (session); usage is per send
        cost = r.get("cost_usd_reported") or 0
        r["_usd"] = cost - prev[r["label"]] if r["send"] > 1 and r["label"] in prev else cost
        prev[r["label"]] = cost
    with Chat(T / "chats" / f"e4-{arm}") as chat:
        nodes, total = dict(chat.log.nodes), chat.total
    if limit is not None:
        inside = lambda k: k is not None and ((k[1] + 1) << k[0]) <= limit
        rows = [r for r in rows if inside(r["_key"])]
        nodes = {k: v for k, v in nodes.items() if inside(k)}
        total = min(total, limit)
