EMAIL = re.compile(r"[\w.+-]+@(?!halvorsen\.example)[\w-]+(\.[\w-]+)+")
_lock = threading.Lock()


def load_jsonl(path: Path) -> list[dict]:
    out = []
    if path.exists():
        with path.open() as fh:
            for line in fh:
                try:
                    out.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
    return out


def append(path: Path, row: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = EMAIL.sub("<email>", json.dumps(row, ensure_ascii=False))
    with _lock, path.open("a") as fh:
        fh.write(text + "\n")
        fh.flush()


def spent(prefix: str = "E5") -> dict:
    out = {"haiku": 0, "sonnet": 0, "opus": 0}
    for row in load_jsonl(LEDGER):
        if str(row.get("experiment", "")).startswith(prefix) and row.get("family") in out:
            out[row["family"]] += int(row.get("n", 0))
    return out


class BudgetCLI(ClaudeCLI):
    """ClaudeCLI with the ledger step replaced: round caps and E5's share, checked under one lock."""

    def _ledger(self, fam: str, n: int, label: str, kind: str, want: int = 0) -> int:
        self.ledger.parent.mkdir(parents=True, exist_ok=True)
        with _lock, self.ledger.open("a+") as fh:
            fcntl.flock(fh, fcntl.LOCK_EX)
            if kind == "reserve":
                fh.seek(0)
                total = mine = 0
                for line in fh.read().splitlines():
                    try:
                        row = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if row.get("family") != fam:
                        continue
                    k = int(row.get("n", 0))
                    total += k
                    if str(row.get("experiment", "")).startswith("E5"):
                        mine += k
                room = min(ROUND_CAPS.get(fam, 0) - total, E5_BUDGET.get(fam, 0) - mine)
