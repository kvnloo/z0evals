+r2['crossovers_cumulative']['W2_with_compactions_Haiku_one_third'] = None
+e5['stock_tools_comparison']['uniichat_turn_call_units'] = 667964
+e5['stock_tools_comparison']['uniichat_scope'] = 'thinned arm, compactions excluded'
+e5['baseline_prompt_first_over_200000'] = {
