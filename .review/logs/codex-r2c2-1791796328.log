        compaction_sends: 2383
        extra_Haiku_smoke_sends: 4
        B2_requests: 95
        Opus_A_requests: 23
        Opus_B_requests: 17
    evidence_priority: Final skeptical report takes precedence over the E4, E6 and E5 experiment reports where they differ
    measured:
    - real-limit batches
    - usage costs at 1h
    - compactor sweep aggregates
    - Claude Code overhead and 5m probes
    harness_graded:
    - recall
    - compliance
    - standing-rule survival
    - correction survival
    inferred:
    - long 5m replay repricing
    - pi overhead and costs
    unmeasured:
    - live pi
