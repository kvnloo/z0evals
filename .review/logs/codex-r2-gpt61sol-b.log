# ---- cost and time -----------------------------------------------------------------------------


def usd_per_unit(calls: list[dict]) -> float | None:
    """The CLI's USD per unit at its own weights (1h write 2.0, 5m write 1.25): one number per model."""
    cost = units = 0.0
    for row in calls:
        if row.get("cost_usd_reported") and row.get("usage"):
            t = tok(row["usage"])
            cost += row["cost_usd_reported"]
            units += t["in"] + 2.0 * t["cw1h"] + 1.25 * t["cw5m"] + 0.1 * t["cr"] + 5 * t["out"]
    return cost / units if units else None


def union(spans: list[tuple[float, float]]) -> float:
    total, end = 0.0, -math.inf
    for a, b in sorted(spans):
        if b > end:
            total += b - max(a, end)
            end = b
    return total


def main() -> None:
    script = json.loads((RES / "script.json").read_text())
    A, B = turns_of("A"), turns_of("B")
    common = sorted(set(A) & set(B))
    last = max(common) if common else 0
    calls_a, calls_b = load(RES / "A" / "calls.jsonl"), load(RES / "B" / "calls.jsonl")
    turn_calls = [r for r in calls_a if str(r.get("label", "")).startswith("turn ")]
    comp_calls = [r for r in calls_a if str(r.get("label", "")).startswith("compact ")]
    # The CLI's cost figure is cumulative inside one process and one resumed session: take differences.
    seen: dict[str, float] = {}
    for row in comp_calls:
        cost = row.get("cost_usd_reported") or 0.0
        row["usd"] = cost - (seen.get(row["label"], 0.0) if row.get("send", 1) > 1 else 0.0)
        seen[row["label"]] = cost
    prev = 0.0
    for row in calls_b:
        cost = row.get("cost_usd_reported") or 0.0
        row["usd"] = cost - prev if cost >= prev else cost
        prev = max(prev, cost)
    for row in turn_calls:
        row["usd"] = row.get("cost_usd_reported") or 0.0
    p_sonnet = usd_per_unit(turn_calls)
    p_haiku = usd_per_unit([r for r in comp_calls if r.get("send", 1) == 1])
    ratio = (p_haiku / p_sonnet) if p_haiku and p_sonnet else None

    starts = [(A[n]["t0"], n) for n in sorted(A)]
    comp_by_turn: dict[int, list[dict]] = defaultdict(list)
    for row in comp_calls:
        owner = None
        for t0, n in starts:
            if row["ts"] >= t0:
                owner = n
        comp_by_turn[owner if owner is not None else starts[0][1]].append(row)

    per, cum = [], {"A1": 0.0, "A2": 0.0, "Ac1": 0.0, "Ac2": 0.0, "B1": 0.0, "B2": 0.0, "Ausd": 0.0, "Acusd": 0.0,
