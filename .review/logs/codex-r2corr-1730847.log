            cc = us.get("cache_creation") or {}
            u["input"] += us.get("input_tokens") or 0
            u["cache_write_1h"] += cc.get("ephemeral_1h_input_tokens") or 0
            u["cache_write_5m"] += cc.get("ephemeral_5m_input_tokens") or 0
            u["cache_write"] += us.get("cache_creation_input_tokens") or 0
            u["cache_read"] += us.get("cache_read_input_tokens") or 0
            u["output"] += us.get("output_tokens") or 0
            u["thinking"] += (us.get("output_tokens_details") or {}).get("thinking_tokens") or 0
            u["usd"] += r["_usd"]
            u["units"] += units(us)
        n = len(rs)
        seen = u["input"] + u["cache_write"] + u["cache_read"]
        walls = [r["wall_s"] for r in rs]
        apis = [r["duration_api_ms"] / 1000 for r in rs if r.get("duration_api_ms")]
        return {"sends": n, **{k: round(v, 4) for k, v in u.items()},
