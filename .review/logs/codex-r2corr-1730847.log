    def summary(items):
        rec = [i for i in items if i["type"] == "recall"]
        com = [i for i in items if i["type"] == "comply" and i["result"] in ("pass", "fail")]
        trap = [i for i in com if i["trap"]]
        return {"recall": tally(rec), "recall_by_category": tally(rec, lambda i: i["cat"]),
                "recall_by_distance": tally(rec, lambda i: bucket(i["distance"])),
                "comply_all_edit_turns": tally(com), "comply_by_check": tally(com, lambda i: i["id"]),
                "comply_by_distance": tally(com, lambda i: bucket(i["distance"])),
                "comply_by_category": tally(com, lambda i: i["cat"]),
                "comply_turn_60_on": tally([i for i in com if i["n"] >= 60]),
                "comply_before_60": tally([i for i in com if i["n"] < 60]),
                "probe_traps": tally(trap), "probe_traps_by_check": tally(trap, lambda i: i["id"]),
                "not_gradable": tally([i for i in items if i["type"] == "comply" and i["result"] in ("na", "cut", "blocked")]),
                "bulk": [i for i in items if i["type"] == "bulk"],
                "failures": [{k: i.get(k) for k in ("n", "type", "id", "cat", "origin", "distance", "trap", "result", "answer", "detail")}
                             for i in items if i["result"] in ("fail", "stale")]}

    not_done = {arm: [n for n in common if script["turns"][n - 1]["kind"] in ("add", "fix", "probe")
