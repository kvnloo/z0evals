+    previous = {}
+    total = 0
+    for row in calls:
+        key = row["label"]
+        cost = row.get("cost_usd_reported") or 0
+        total += cost - (previous.get(key, 0) if row["send"] > 1 else 0)
+        previous[key] = cost
+    return total
