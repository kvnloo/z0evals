    as_compaction = [n for n in common if re.match(r"\s*(user|unii|echo|tool|note|work)\s*[:(]", A[n].get("reply") or "")]
    zoom_turns = [(r["n"], r["kind"], r["A"]["zooms"], r["A"]["zoom_depths"]) for r in per if r["A"]["zooms"]]
    comp_sends = len(comp_calls)
    comp_fail = [r for r in comp_calls if r.get("is_error")]
    tool_tries = defaultdict(int)
    for r in comp_fail:
        for e in r.get("events", []):
            if e.get("type") == "assistant":
                for b in e["message"].get("content", []):
                    if b.get("type") == "tool_use":
                        tool_tries[b.get("name")] += 1
    tree_rows = []
    for path in sorted((RES.parents[1] / "chats" / "e5-A" / "tree").glob("*.jsonl")):
        tree_rows += load(path)
    by_level = defaultdict(list)
    for node in tree_rows:
        by_level[node["l"]].append(node["size"])
    first_sends = defaultdict(int)
    for r in comp_calls:
        first_sends[r["label"]] = max(first_sends[r["label"]], r.get("send", 1))

    b_prompt = [(r["n"], r["B"]["prompt_tokens_last"]) for r in per]
    b_compacts = [(n, B[n]["compact_events"]) for n in common if B[n].get("compact_events")]
    drops = [(per[i]["n"], per[i - 1]["B"]["prompt_tokens_last"], per[i]["B"]["prompt_tokens_last"])
             for i in range(1, len(per)) if per[i]["B"]["prompt_tokens_last"] < 0.8 * per[i - 1]["B"]["prompt_tokens_last"]]


